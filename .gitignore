__pycache__/
# Simulation results. Regenerated by sim/run.sh, sim/run_pvt.sh and the benches beside them --
# never committed, because an archived result is indistinguishable from a fresh one and
# outlives the schematic it was measured on. tools/datasheet.py reads them locally; its
# --check is what ties the published figures to a fresh run.
sim/pvt/
sim/netlist/
sim/_report_*.log
sim/_psrr_pvt.txt
sim/*.csv
# Rebuilt from each run's top-level netlist (the benches include it); never a source file.
sim/ldo_cells.spice
